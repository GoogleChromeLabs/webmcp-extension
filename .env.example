# Set the API key for the provider selected below.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

# The model is written as provider:model.
MODEL=google:gemini-3.6-flash

# Optional server settings. Comments must be on their own line.
# PORT=3000
# HOST=127.0.0.1
# WEBMCP_AUTH_TOKEN=
# ALLOWED_EXTENSION_ID=
# WEBMCP_LOG_REDACT_BODIES=1

# Optional provider endpoints for local runtimes, proxies, or gateways.
# OPENAI_BASE_URL=http://localhost:4000/v1
# ANTHROPIC_BASE_URL=https://gateway.example.com/anthropic
# GOOGLE_GENERATIVE_AI_BASE_URL=https://gateway.example.com/google
# OLLAMA_HOST=http://127.0.0.1:11434/v1
