{
  "manifest_version": 3,
  "name": "WebMCP Extension",
  "description": "Inspect, monitor, and execute WebMCP tools",
  "version": "1.0.0",
  "minimum_chrome_version": "150.0.7861.0",
  "permissions": [
    "sidePanel",
    "scripting",
    "webNavigation",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html",
    "default_title": "WebMCP Extension"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start",
      "js": [
        "content.js"
      ]
    }
  ]
}