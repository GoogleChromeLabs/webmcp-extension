{
  "name": "webmcp-extension",
  "version": "1.0.0",
  "description": "Chrome extension and companion server for inspecting, monitoring, and executing WebMCP tools exposed by web pages.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoogleChromeLabs/webmcp-extension.git"
  },
  "bugs": {
    "url": "https://github.com/GoogleChromeLabs/webmcp-extension/issues"
  },
  "homepage": "https://github.com/GoogleChromeLabs/webmcp-extension#readme",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build": "node scripts/build.ts",
    "dev": "node scripts/build.ts --watch",
    "test": "node scripts/test.ts",
    "test:unit": "node scripts/test.ts unit",
    "test:smoke": "node scripts/test.ts smoke",
    "clean": "node scripts/clean.ts",
    "screenshots": "node scripts/screenshots.ts",
    "server": "node server/server.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.56",
    "@ai-sdk/google": "^4.0.74",
    "@ai-sdk/openai": "^4.0.69",
    "ai": "^7.0.105",
    "easy-language-model": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^19.2.8",
    "streaming-markdown-html": "^0.1.1"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.3",
    "@types/chrome": "^0.0.310",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.27.3",
    "linkedom": "^0.18.13",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.7.3",
    "webmcp-types": "^0.1.9"
  }
}
