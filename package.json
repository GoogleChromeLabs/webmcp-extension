{
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "dev": "npm run watch",
    "test": "rm -rf dist/tests && npx esbuild tests/*.test.ts --bundle --platform=node --packages=external --format=esm --jsx=automatic --outdir=dist/tests && node --test dist/tests/*.test.js",
    "clean": "rm -rf dist",
    "server": "node server/server.js"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "easy-language-model": "^0.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.310",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.3"
  }
}
